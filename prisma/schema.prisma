datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  password  String
  role      Role     @default(DRIVER)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  DRIVER
}