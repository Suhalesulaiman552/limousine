datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DRIVER
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  password  String
  role      Role     @default(DRIVER)
  createdAt DateTime @default(now())
}

model Booking {
  id          String   @id @default(uuid())
  clientName  String
  clientPhone String
  vehicle     String
  pickup      String
  dropoff     String
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now())
}

model Fine {
  id        String   @id @default(uuid())
  vehicle   String
  driver    String
  amount    Float
  reason    String
  createdAt DateTime @default(now())
}